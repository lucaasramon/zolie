{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "/(?!robots\\.txt$).*",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(meta-externalagent|meta-webindexer|GPTBot|ClaudeBot|CCBot|Bytespider|PerplexityBot).*"
        }
      ],
      "mitigate": {
        "action": "deny"
      }
    }
  ],
  "crons": [
    {
      "path": "/api/v1/cron/abandoned-carts",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/v1/cron/expire-orders",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/v1/cron/sync-tracking",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/v1/cron/review-requests",
      "schedule": "0 14 * * *"
    }
  ]
}
