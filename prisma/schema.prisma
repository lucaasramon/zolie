generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Material {
  PRATA_925
  BANHADO_OURO
}

enum OrderStatus {
  AGUARDANDO_PAGAMENTO
  PROCESSANDO
  SEPARANDO
  ENVIADO
  ENTREGUE
  CANCELADO
}

enum PaymentMethod {
  CARTAO_CREDITO
  PIX
  BOLETO
}

enum DiscountType {
  PERCENT
  FIXED
  FREE_SHIPPING
}

enum UserRole {
  CUSTOMER
  ADMIN
}

model User {
  id            String    @id @default(uuid())
  nome          String
  email         String    @unique
  senhaHash     String    @map("senha_hash")
  telefone      String?
  cpf           String?   @unique
  asaasCustomerId String? @unique @map("asaas_customer_id")
  role          UserRole  @default(CUSTOMER)
  emailVerified Boolean   @default(false) @map("email_verified")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  addresses     Address[]
  cart          Cart?
  orders        Order[]
  reviews       ProductReview[]
  wishlist      WishlistItem[]
  resetTokens   PasswordResetToken[]
  verificationTokens EmailVerificationToken[]
  returnRequests ReturnRequest[]
  couponRedemptions CouponRedemption[]

  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  token     String    @unique
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  token     String    @unique
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_verification_tokens")
}

model Address {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  apelido     String?
  cep         String
  rua         String
  numero      String
  complemento String?
  bairro      String
  cidade      String
  estado      String   @db.Char(2)
  principal   Boolean  @default(false)
  // Soft delete: `Order` referencia o endereço, então apagá-lo de verdade
  // quebraria o histórico fiscal do pedido.
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime @default(now()) @map("created_at")

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders      Order[]

  @@index([userId])
  @@map("addresses")
}

model Category {
  id        String    @id @default(uuid())
  nome      String
  slug      String    @unique
  imagem    String?
  ordem     Int       @default(0)
  ativa     Boolean   @default(true)
  createdAt DateTime  @default(now()) @map("created_at")

  products  Product[]

  @@map("categories")
}

model Product {
  id               String          @id @default(uuid())
  nome             String
  slug             String          @unique
  sku              String?         @unique
  descricao        String
  cuidados         String?
  preco            Decimal         @db.Decimal(10, 2)
  precoPromocional Decimal?        @db.Decimal(10, 2) @map("preco_promocional")
  material         Material
  categoriaId      String          @map("categoria_id")
  estoque          Int             @default(0)
  pesoGramas       Decimal?        @db.Decimal(6, 2) @map("peso_gramas")
  pedra            String?
  tamanhos         String[]
  imagens          String[]
  destaque         Boolean         @default(false)
  lancamento       Boolean         @default(false)
  ativo            Boolean         @default(true)
  notaMedia        Decimal         @default(0) @db.Decimal(2, 1) @map("nota_media")
  totalAvaliacoes  Int             @default(0) @map("total_avaliacoes")
  // Preço de custo simples do produto, informado direto no cadastro (distinto da
  // composição de custo da tela /admin/precificacao). Nunca exposto na API pública.
  precoCusto       Decimal?        @db.Decimal(10, 2) @map("preco_custo")
  // Custo da semijoia usado na tela de precificação (/admin/precificacao). Ao salvar,
  // o preço de venda (`preco`) é recalculado automaticamente a partir deste custo.
  custoSemijoia    Decimal?        @db.Decimal(10, 2) @map("custo_semijoia")
  // Override manual do custo de embalagem; null = usar o valor somado dos `productSupplies`.
  custoEmbalagem   Decimal?        @db.Decimal(10, 2) @map("custo_embalagem")
  // Última margem (%) usada na calculadora, para reabrir a tela com o mesmo valor.
  margemDesejada   Decimal?        @db.Decimal(5, 2) @map("margem_desejada")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  categoria        Category        @relation(fields: [categoriaId], references: [id])
  reviews          ProductReview[]
  cartItems        CartItem[]
  orderItems       OrderItem[]
  wishlist         WishlistItem[]
  variants         ProductVariant[]
  productSupplies  ProductSupply[]
  slugHistory      ProductSlugHistory[]

  @@index([categoriaId])
  @@index([material])
  @@index([destaque])
  @@index([lancamento])
  @@map("products")
}

// Slugs antigos de produtos renomeados — permite redirecionar (308) URLs
// já compartilhadas/indexadas para a URL atual em vez de quebrar em 404.
// Gravado automaticamente sempre que `productService.update` muda o slug.
model ProductSlugHistory {
  id        String   @id @default(uuid())
  productId String   @map("product_id")
  oldSlug   String   @unique @map("old_slug")
  createdAt DateTime @default(now()) @map("created_at")

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_slug_history")
}

enum SupplyCategoria {
  EMBALAGEM
  BRINDE
}

// Insumo comprado em lote (sacola, caixinha, tag...) usado no rateio de custo dos
// produtos na tela de precificação. custoUnitario = valorPago / quantidadeLote,
// calculado em supply.service.ts (não fica gravado, evita desatualizar).
model Supply {
  id             String          @id @default(uuid())
  nome           String
  valorPago      Decimal         @db.Decimal(10, 2) @map("valor_pago")
  quantidadeLote Int             @map("quantidade_lote")
  categoria      SupplyCategoria @default(EMBALAGEM)
  // Insumo que não será mais reposto (ex.: ferramenta comprada uma vez), mas cujo
  // custo já rateado em produtos existentes deve continuar visível — por isso soft
  // delete em vez de exclusão real.
  ativo          Boolean         @default(true)
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  productSupplies ProductSupply[]

  @@map("supplies")
}

// Quais insumos de embalagem entram no rateio de custo de cada produto (ex.: a
// flanela só é usada nos produtos de prata).
model ProductSupply {
  id        String  @id @default(uuid())
  productId String  @map("product_id")
  supplyId  String  @map("supply_id")

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  supply    Supply  @relation(fields: [supplyId], references: [id], onDelete: Cascade)

  @@unique([productId, supplyId])
  @@index([productId])
  @@map("product_supplies")
}

// Estoque por combinação de tamanho + acabamento. `Product.estoque` continua
// existindo como total agregado (usado no catálogo e nos relatórios); a verdade
// por variação vive aqui e é o que o checkout consome.
model ProductVariant {
  id         String   @id @default(uuid())
  productId  String   @map("product_id")
  tamanho    String?
  acabamento String?
  estoque    Int      @default(0)
  // Sobrepõe o peso do produto quando a variação pesa diferente.
  pesoGramas Decimal? @db.Decimal(6, 2) @map("peso_gramas")
  sku        String?  @unique
  ativo      Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, tamanho, acabamento])
  @@index([productId])
  @@map("product_variants")
}

model ProductImage {
  id        String   @id @default(uuid())
  mimeType  String   @map("mime_type")
  bytes     Bytes
  createdAt DateTime @default(now()) @map("created_at")

  @@map("product_images")
}

model ProductReview {
  id         String   @id @default(uuid())
  productId  String   @map("product_id")
  userId     String   @map("user_id")
  nota       Int
  titulo     String?
  comentario String?
  imagens    String[]
  aprovado   Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at")

  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@index([productId])
  @@map("product_reviews")
}

model Cart {
  id                   String     @id @default(uuid())
  userId               String?    @unique @map("user_id")
  sessionId            String?    @unique @map("session_id")
  abandonedEmailSentAt DateTime?  @map("abandoned_email_sent_at")
  createdAt            DateTime   @default(now()) @map("created_at")
  updatedAt            DateTime   @updatedAt @map("updated_at")

  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]

  @@map("carts")
}

model CartItem {
  id         String  @id @default(uuid())
  cartId     String  @map("cart_id")
  productId  String  @map("product_id")
  quantidade Int     @default(1)
  tamanho    String?
  acabamento String?

  cart       Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product    Product @relation(fields: [productId], references: [id])

  @@unique([cartId, productId, tamanho, acabamento])
  @@map("cart_items")
}

model Order {
  id             String        @id @default(uuid())
  numero         String        @unique
  userId         String?       @map("user_id")
  enderecoId     String?       @map("endereco_id")
  status         OrderStatus   @default(AGUARDANDO_PAGAMENTO)
  formaPagamento PaymentMethod @map("forma_pagamento")
  parcelas       Int           @default(1)
  subtotal       Decimal       @db.Decimal(10, 2)
  frete          Decimal       @db.Decimal(10, 2)
  desconto       Decimal       @default(0) @db.Decimal(10, 2)
  total          Decimal       @db.Decimal(10, 2)
  cupomCodigo    String?       @map("cupom_codigo")
  transportadora String?
  codigoRastreio String?       @map("codigo_rastreio")
  asaasPaymentId String?       @unique @map("asaas_payment_id")
  asaasStatus    String?       @map("asaas_status")
  // Etiqueta do Melhor Envio: o id só existe depois do checkout (etiqueta paga).
  // `etiquetaUrl` é o PDF para impressão; o rastreio chega depois, via job.
  // `envioServicoId` guarda a modalidade escolhida na cotação (PAC, Sedex...),
  // necessária para comprar a etiqueta da mesma forma que foi cobrada do cliente.
  envioServicoId String?       @map("envio_servico_id")
  melhorEnvioId  String?       @unique @map("melhor_envio_id")
  etiquetaUrl    String?       @map("etiqueta_url")
  // Nota fiscal: emitida fora do sistema, referenciada aqui para o cliente
  // conseguir baixar pela página do pedido.
  notaFiscalUrl   String?      @map("nota_fiscal_url")
  notaFiscalChave String?      @map("nota_fiscal_chave")
  notaFiscalNumero String?     @map("nota_fiscal_numero")
  // Checkout de convidado (sem conta): preenchidos só quando `userId`/`enderecoId`
  // são nulos. Um pedido é um snapshot imutável, então o contato e endereço do
  // convidado ficam gravados aqui em vez de numa entidade `Address` reutilizável
  // (que não faz sentido para um endereço usado uma única vez).
  guestNome        String?     @map("guest_nome")
  guestEmail       String?     @map("guest_email")
  guestTelefone    String?     @map("guest_telefone")
  guestCpf         String?     @map("guest_cpf")
  guestCep         String?     @map("guest_cep")
  guestRua         String?     @map("guest_rua")
  guestNumero      String?     @map("guest_numero")
  guestComplemento String?     @map("guest_complemento")
  guestBairro      String?     @map("guest_bairro")
  guestCidade      String?     @map("guest_cidade")
  guestEstado      String?     @map("guest_estado") @db.Char(2)
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  user           User?         @relation(fields: [userId], references: [id])
  endereco       Address?      @relation(fields: [enderecoId], references: [id])
  items          OrderItem[]
  events         OrderEvent[]
  returnRequests ReturnRequest[]
  couponRedemptions CouponRedemption[]

  @@index([userId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id            String  @id @default(uuid())
  orderId       String  @map("order_id")
  productId     String  @map("product_id")
  nomeProduto   String  @map("nome_produto")
  precoUnitario Decimal @db.Decimal(10, 2) @map("preco_unitario")
  quantidade    Int
  tamanho       String?
  acabamento    String?
  subtotal      Decimal @db.Decimal(10, 2)

  order         Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product       Product @relation(fields: [productId], references: [id])
  returnItems   ReturnItem[]

  @@index([orderId])
  @@map("order_items")
}

model OrderEvent {
  id        String      @id @default(uuid())
  orderId   String      @map("order_id")
  status    OrderStatus
  descricao String?
  createdAt DateTime    @default(now()) @map("created_at")

  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_events")
}

enum CouponPurchaseRestriction {
  PRIMEIRA
  SEGUNDA
}

model Coupon {
  id              String                     @id @default(uuid())
  codigo          String                     @unique
  descricao       String?
  tipoDesconto    DiscountType               @map("tipo_desconto")
  valor           Decimal                    @db.Decimal(10, 2)
  minimoPedido    Decimal?                   @db.Decimal(10, 2) @map("minimo_pedido")
  usoMaximo       Int?                       @map("uso_maximo")
  usos            Int                        @default(0)
  // Restringe o cupom a uma etapa específica do histórico de compras do cliente
  // (ex: BEMVINDO10 só na 1ª, VOLTEI10 só na 2ª). null = sem restrição por etapa.
  restricaoCompra CouponPurchaseRestriction? @map("restricao_compra")
  validade        DateTime?
  ativo           Boolean                    @default(true)
  createdAt       DateTime                   @default(now()) @map("created_at")

  redemptions     CouponRedemption[]

  @@map("coupons")
}

// Registra que um usuário já resgatou um cupom específico — impõe uso único
// por pessoa (o contador `Coupon.usos` é só global, não por usuário). Removido
// quando o pedido correspondente é cancelado/expira sem pagamento, liberando
// o cupom para uma nova tentativa.
model CouponRedemption {
  id        String   @id @default(uuid())
  couponId  String   @map("coupon_id")
  userId    String   @map("user_id")
  orderId   String   @map("order_id")
  createdAt DateTime @default(now()) @map("created_at")

  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([couponId, userId])
  @@index([userId])
  @@map("coupon_redemptions")
}

model WishlistItem {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  productId String   @map("product_id")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("wishlist_items")
}

// Mensagens do formulário de contato. Guardadas além do e-mail para nada se
// perder se o envio falhar, e para o admin conseguir consultar o histórico.
model ContactMessage {
  id        String    @id @default(uuid())
  nome      String
  email     String
  assunto   String
  mensagem  String
  pedido    String?
  respondida Boolean  @default(false)
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([respondida, createdAt])
  @@map("contact_messages")
}

enum ReturnStatus {
  SOLICITADA
  APROVADA
  RECUSADA
  RECEBIDA
  CONCLUIDA
}

enum ReturnType {
  TROCA
  DEVOLUCAO
}

// Solicitação de troca/devolução de pedido já entregue (CDC art. 49 e política
// de 30 dias da loja). Cancelamento de pedido não entregue é outro fluxo,
// tratado em order.service.cancelar().
model ReturnRequest {
  id           String       @id @default(uuid())
  orderId      String       @map("order_id")
  userId       String       @map("user_id")
  tipo         ReturnType
  status       ReturnStatus @default(SOLICITADA)
  motivo       String
  descricao    String?
  imagens      String[]
  // Preenchido pelo admin ao aprovar/recusar — vai no e-mail ao cliente.
  respostaAdmin String?     @map("resposta_admin")
  codigoReversa String?     @map("codigo_reversa")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  order        Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  items        ReturnItem[]

  @@index([userId])
  @@index([status])
  @@map("return_requests")
}

model ReturnItem {
  id         String   @id @default(uuid())
  returnId   String   @map("return_id")
  orderItemId String  @map("order_item_id")
  quantidade Int      @default(1)

  request    ReturnRequest @relation(fields: [returnId], references: [id], onDelete: Cascade)
  orderItem  OrderItem     @relation(fields: [orderItemId], references: [id])

  @@index([returnId])
  @@map("return_items")
}

model Banner {
  id        String   @id @default(uuid())
  titulo    String
  subtitulo String?
  tag       String?
  cta       String?
  link      String?
  imagem    String?
  ordem     Int      @default(0)
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("banners")
}
